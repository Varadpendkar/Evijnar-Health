# Evijnar Health Dashboard - Environment Configuration

# API Configuration
# Production: https://api.evijnar.com
# Development: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Authentication
# Optional: Enable authentication (currently disabled for development)
# NEXT_PUBLIC_AUTH_ENABLED=false

# Analytics
# Optional: Add analytics tracking
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# Feature Flags
# Enable/disable features
NEXT_PUBLIC_FEATURE_VOICE_SEARCH=true
NEXT_PUBLIC_FEATURE_HEALTH_TOURISM=true
NEXT_PUBLIC_FEATURE_RECOVERY_BRIDGE=true
NEXT_PUBLIC_FEATURE_BLOCKCHAIN_PAYMENT=true

# UI Configuration
# Customize colors, pagination, etc.
NEXT_PUBLIC_HOSPITALS_PER_PAGE=10
NEXT_PUBLIC_PROCEDURES_PER_PAGE=15
NEXT_PUBLIC_ANIMATION_ENABLED=true

# Map Configuration (for future use)
# NEXT_PUBLIC_MAPBOX_TOKEN=your-token

# Payment Configuration (for future integration)
# NEXT_PUBLIC_PAYMENT_GATEWAY=stripe
# NEXT_PUBLIC_PAYMENT_KEY=your-key

# Logging
# Control logging verbosity
NEXT_PUBLIC_LOG_LEVEL=info

# Development Only
# NODE_ENV=development
# Next.js Debug mode (uncomment to enable)
# DEBUG=*
